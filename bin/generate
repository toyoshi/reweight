#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/reweight"

puts "=== Reweight: ニュースレター生成 ==="
puts ""

# Step 1: RSSフィード取得
puts "## Step 1: RSSフィード取得"
fetcher = Reweight::FeedFetcher.new
articles = fetcher.fetch_all
puts "Total: #{articles.size} articles"
puts ""

if articles.empty?
  warn "No articles fetched. Check your feed configuration."
  exit 1
end

# Step 2: おだやかニュース判定（スクリーニング → バッチスコアリング+要約）
puts "## Step 2: おだやかニュース判定 + 要約"
judge = Reweight::ProgressJudge.new
judge.judge_all(articles)
top_articles = judge.select_top(articles, count: 10)
puts "Top 10:"
top_articles.each { |a| puts "  #{a.progress_score}pt - #{a.title}" }
puts ""

# Step 3: 要約フォールバック（バッチで要約が取得できなかった記事のみ）
puts "## Step 3: 要約フォールバック"
summarizer = Reweight::Summarizer.new
summarizer.summarize_all(top_articles)
puts ""

# Step 4: メール本文生成・保存
puts "## Step 4: メール本文生成"
composer = Reweight::EmailComposer.new(top_articles)
path = composer.save
puts ""
puts "=== Done! ==="
puts "Output: #{path}"
